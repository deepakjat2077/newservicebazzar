APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Daily rotation. LOG_DAILY_DAYS is how many day-files to keep: 1 means only
# today's laravel-YYYY-MM-DD.log survives, older ones are deleted automatically
# (no cron needed). Use 2 if you want a full 24h of history at any moment —
# with 1, just after midnight yesterday's log is already gone.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=1
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=example_app
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (served over HTTPS) set these two to true so the session
# cookie is encrypted at rest and never sent over plain HTTP:
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true

# Gupshup WhatsApp credentials are managed from the admin panel
# (Setting > WhatsApp Setting) and stored on the settings row; whatever is
# saved there overrides these. Keys below act as fallbacks only.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
GUPSHUP_TEMPLATE_ID=
GUPSHUP_OTP_TEMPLATE_ID=
GUPSHUP_ENQUIRY_TEMPLATE_ID=

# Shared secret Gupshup must send back (as a `token` query param) on its
# webhook callback URL. Leave unset only for local testing.
GUPSHUP_WEBHOOK_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Connection used specifically by the analytics tracking jobs
# (App\Jobs\Tracking\*). Defaults to "sync" (runs immediately, in-request)
# because a queue worker process is not guaranteed to be running in every
# environment. Set to "database" once `php artisan queue:work` is running
# continuously (Supervisor/systemd/cron) for true async processing.
# TRACKING_QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Geocoding (address -> lat/lng). Set at least one on live —
# Nominatim (the keyless fallback) 403s shared hosting IPs.
LOCATIONIQ_KEY=
GOOGLE_MAPS_KEY=
